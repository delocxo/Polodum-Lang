todos = [];

for do
    println("");
    println("=== TO DO ===");
    println("1. Add task");
    println("2. View tasks");
    println("3. Quit");

    print("> ");
    choice = input();

    if choice == "1" do
        print("Task: ");
        text = input();

        todos.push(Todo {
            text = text
        });

        println("Added!");
    elseif choice == "2" do
        println("");
        println("Your tasks:");

        if todos.isEmpty do
            println("Nothing to do!");
        else
            for todo in todos do
                println("- " + todo.text);
            end
        end
    elseif choice == "3" do
        println("Goodbye!");
        break;
    else
        println("Invalid option.");
    end
end